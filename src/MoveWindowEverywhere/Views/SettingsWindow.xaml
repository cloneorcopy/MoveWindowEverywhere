<Window x:Class="MoveWindowEverywhere.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move Window Everywhere 设置"
        Width="470"
        Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 快捷键 -->
        <TextBlock Grid.Row="0"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"
                   Text="全局快捷键" />

        <TextBlock Grid.Row="0"
                   Margin="0,2,0,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   FontSize="11.5"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="按下后把选中的窗口移动到鼠标当时所在的显示器" />

        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Padding="14"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock x:Name="HotkeyTextBlock"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center"
                           Text="{Binding PendingHotkeyText}" />
                <TextBlock x:Name="CaptureHintTextBlock"
                           Margin="0,6,0,0"
                           FontSize="11.5"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           Text="请按下新的组合键"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Style="{StaticResource FlatButton}"
                    Content="恢复默认快捷键"
                    Click="OnResetHotkeyClick" />
            <Button Margin="8,0,0,0"
                    Style="{StaticResource FlatButton}"
                    Content="重新录制"
                    Click="OnCaptureClick" />
        </StackPanel>

        <!-- 行为开关 -->
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Text="行为" />
            <Border Margin="0,10,0,0"
                    Padding="14,4,14,10"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <CheckBox Margin="0,8,0,0"
                              Content="随 Windows 启动"
                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                              IsEnabled="{Binding CanRegisterStartup}"
                              Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="22,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding StartupHint}" />

                    <CheckBox Margin="0,14,0,0"
                              Content="窗口列表包含最小化窗口"
                              IsChecked="{Binding IncludeMinimizedWindows, Mode=TwoWay}"
                              Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="22,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="选中最小化窗口时会把它在目标显示器上恢复为普通窗口。" />

                    <CheckBox Margin="0,14,0,0"
                              Content="选择器失去焦点时自动关闭"
                              IsChecked="{Binding CloseSelectorOnFocusLost, Mode=TwoWay}"
                              Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="22,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="关闭后选择器会一直停留，需要按 Esc 或点击列表项才会消失。" />

                    <CheckBox Margin="0,14,0,0"
                              Content="快捷键被占用时自动改用备用组合"
                              IsChecked="{Binding AutoFallbackHotkey, Mode=TwoWay}"
                              Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="22,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="先尝试保留按键、只改修饰键，例如 Alt + Z 换成 Alt + Shift + Z。" />

                    <CheckBox Margin="0,14,0,0"
                              Content="窗口列表显示缩略图"
                              IsChecked="{Binding ShowThumbnails, Mode=TwoWay}"
                              Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="22,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="缩略图在后台截取，最小化或无响应的窗口显示为无预览。" />
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock x:Name="ErrorTextBlock"
                   Grid.Row="5"
                   Margin="0,10,0,0"
                   FontSize="11.5"
                   Foreground="#C0392B"
                   TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}" />

        <StackPanel Grid.Row="6"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Style="{StaticResource FlatButton}"
                    Content="取消"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Content="保存"
                    IsDefault="True"
                    Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
