<Window x:Class="MoveWindowEverywhere.Views.SelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move Window Everywhere"
        Width="700"
        Height="520"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Border Margin="12"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.22"
                              Color="#20303C" />
        </Border.Effect>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Text="移动窗口到目标显示器" />
                <TextBlock Grid.Column="1"
                           FontSize="12"
                           Foreground="{StaticResource AccentBrush}"
                           Text="{Binding TargetMonitorText}" />
            </Grid>

            <!-- 搜索框 -->
            <Grid Grid.Row="1">
                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Height="34">
                    <TextBox x:Name="SearchTextBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             FontSize="13.5"
                             Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource TextBrush}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13.5"
                           Foreground="{StaticResource MutedTextBrush}"
                           IsHitTestVisible="False"
                           Text="搜索窗口标题或进程名…"
                           Visibility="{Binding IsSearchEmpty, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>

            <!-- 窗口列表 -->
            <Grid Grid.Row="2" Margin="0,10,0,8">
                <ListBox x:Name="WindowListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Windows}"
                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource SelectorListBoxItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="OnWindowItemDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 缩略图。截取在后台逐张进行，未完成或无法截取时显示占位文字 -->
                                <Border Grid.Column="0"
                                        Width="96"
                                        Height="56"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        ClipToBounds="True"
                                        SnapsToDevicePixels="True"
                                        Visibility="{Binding ThumbnailColumnVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Grid>
                                        <TextBlock FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="无预览">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="Uniform"
                                               SnapsToDevicePixels="True" />
                                    </Grid>
                                </Border>

                                <Image Grid.Column="1"
                                       Width="20"
                                       Height="20"
                                       Margin="0,0,10,0"
                                       Source="{Binding Icon}"
                                       SnapsToDevicePixels="True" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,1,0,0"
                                               FontSize="11.5"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding ProcessText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="3"
                                        Margin="8,0,0,0"
                                        Padding="6,1"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        ToolTip="该窗口当前所在的显示器">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MonitorIndex}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" Text="{Binding MonitorLabel}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnTargetMonitor}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Grid.Column="4"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11.5"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding StateText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Background="{StaticResource SurfaceBrush}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock FontSize="13.5"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="没有可移动的窗口" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11.5"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="当前没有匹配筛选条件的窗口，按 Esc 关闭" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 底部提示 -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           FontSize="11.5"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="↑ ↓ 选择 · Enter 移动 · Esc 取消 · 双击移动" />
                <TextBlock Grid.Column="1"
                           FontSize="11.5"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="目标：快捷键触发时鼠标所在的显示器" />
            </Grid>
        </Grid>
    </Border>
</Window>
